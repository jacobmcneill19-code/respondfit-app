rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos and videos members share. File names are long random codes, so they cannot be guessed.
    match /blobs/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && resource.metadata.uid == request.auth.uid;
    }
  }
}
